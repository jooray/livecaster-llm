# Livecaster configuration.
#
# Copy to `livecaster.toml` next to your outline, or to ~/.config/livecaster/livecaster.toml.
# Every key can be overridden per run:  livecaster run outlines/osnova.md --set llm.tick_interval_s=15
# Environment variables work too:       LIVECASTER_LLM__TICK_MODEL=deepseek-v4-pro-0813

[audio]
mode = "remote"       # live (one room) | remote (Zencastr, Meet, Riverside …)
record = true         # keep a 16 kHz WAV backup per channel in the session directory
record_native = false # also keep the untouched device-rate stream

# --- In person, one shared microphone: keep a single channel and drop the Guest block.
[[audio.channels]]
name = "Host"
# device:auto | device:<name or index> | audiotee:<app or pid> | file:<path>
#
# `device:auto` is whichever microphone is plugged in when you press Start, the
# system default first — so the config survives a headset staying in its case.
# Naming one pins it; if that name is gone at Start, Livecaster records from an
# available device and says so rather than refusing to start. The cog in the UI
# lists every device by name and switches channels without a restart.
source = "device:auto"
channel_index = 0                          # one channel of a multi-channel interface; omit to average

# --- Remote: the guest arrives through the browser. Wear headphones.
[[audio.channels]]
name = "Guest"
source = "audiotee:Google Chrome"          # macOS 14.2+, after ./helpers/audiotee/build.sh
# source = "device:BlackHole 2ch"          # macOS fallback: BlackHole + a Multi-Output Device
# source = "device:alsa_output.…analog-stereo.monitor"   # Linux: pactl list sources short
is_direct = true                           # wins the cross-talk dedupe against the microphone

[stt]
engine = "auto"        # auto | parakeet-mlx | onnx-asr | whisper-mlx | faster-whisper
model = ""             # empty = the engine's default model

# auto | sk | cs | en | …  Only the Whisper engines can actually be *told* what
# language they are hearing. Parakeet v3 detects it per utterance and cannot be
# forced (DECISIONS D20): with it, this fixes the language of the notes and the
# prompts, and drops lines that come back in the wrong alphabet entirely.
# You can also lock or release the language live, from the pill in the top bar.
#
# For a hard lock — measured on Slovak, every line stayed Slovak. Whisper pads
# every utterance to a 30 s window, so it costs the same for "tak" as for a
# sentence; what differs is where it runs:
#   uv sync --extra mac-whisper    # GPU, 2.6 s/utterance — usable live, pulls PyTorch
#   livecaster run outlines/osnova.md --set stt.engine=whisper-mlx --set stt.language=sk
#   uv sync --extra whisper        # CPU, 15 s/utterance — for a re-run, no PyTorch
#   livecaster replay sessions/<dir> --set stt.engine=faster-whisper --set stt.language=sk
# Parakeet, for comparison: 0.25 s/utterance and no way to force the language.
language = "auto"
cpu_threads = 0        # faster-whisper only; 0 = the CTranslate2 default

vad_threshold = 0.5
silence_ms = 600       # silence that ends an utterance
min_speech_ms = 300    # shorter bursts are dropped
max_utterance_s = 20   # hard cut, at the quietest frame of the last 3 s
preroll_ms = 300

[llm]
base_url = "https://api.venice.ai/api/v1"
default_provider = "venice"                 # where a model with no `provider:` prefix goes

# -fast costs twice as much per output token but answers in ~9 s instead of ~38 s.
tick_model = "deepseek-v4-flash-0731-fast"
# Venice proxies Claude, so Sonnet 5 bills against the same prepaid credits.
# Prefix a model to send it somewhere else: "anthropic:claude-sonnet-5" (needs
# `uv sync --extra anthropic` and ANTHROPIC_API_KEY) or "openai:gpt-5".
final_model = "claude-sonnet-5"
tick_interval_s = 25
min_new_words = 25                          # do not tick before this much was said
burst_words = 120                           # tick immediately past this
transcript_window_words = 1200
# none | low | medium | high | xhigh | max. Venice takes none/low/high and narrows
# the rest; the Anthropic API takes all six. See DECISIONS.md (D8, D17).
reasoning_effort_tick = "none"
reasoning_effort_final = "high"
temperature = 0.2
cover_threshold = 0.7                       # confidence needed to strike a topic through
touch_threshold = 0.4
heading_cover_threshold = 0.85              # confidence needed to cover a whole section
manual_lock_minutes = 10                    # after you un-cover an item, the LLM keeps out
preflight = true                            # one call before the session: questions and triggers

# Each provider: `kind` is the wire protocol, not the vendor. Override a base URL
# or a key variable here; anything you leave out keeps the built-in default.
[llm.providers.venice]
kind = "openai"
base_url = "https://api.venice.ai/api/v1"
api_key_env = "VENICE_API_KEY"
venice_extensions = true    # system-prompt suppression and web-search switches

[llm.providers.anthropic]
kind = "anthropic"
api_key_env = "ANTHROPIC_API_KEY"

[llm.providers.openai]
kind = "openai"
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"

[wrapup]
resolve_links = false   # web search for missing URLs; slower and costs more

[ui]
# 0.0.0.0 opens the map to a tablet on your LAN. Anything but loopback mints a
# per-session key that off-machine clients must present; the URL to type into the
# tablet, key included, is printed at startup. `livecaster run --lan` does the same
# without editing this file. Your own browser still connects over loopback and
# needs no key.
host = "127.0.0.1"
port = 8766
open_browser = true
theme = "dark"          # dark | light

[session]
dir = "sessions"
# How long the episode is meant to run, in minutes. Leave it out and there is no
# budget: the app shows a clock and nothing else. Set it and the map can weigh what
# is still unasked against the time left.
# target_minutes = 60
